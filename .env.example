# ============================================
# LangChain + RAG 项目环境变量配置
# ============================================
# 使用方法：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 填入你的 API Key
# ============================================

# OpenAI API 配置
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# 可选：指定使用的模型
# OPENAI_MODEL=gpt-4
# OPENAI_EMBEDDING_MODEL=text-embedding-ada-002